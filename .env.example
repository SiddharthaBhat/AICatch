# AICatch Environment Configuration Template
# Copy this file to .env and configure as needed.

# Host and Port Configuration
PORT=8000
HOST=0.0.0.0

# Hardware Placement Targets (cuda / cpu)
AICATCH_DEVICE=cuda
AICATCH_FACE_DEVICE=cpu
AICATCH_OCR_DEVICE=cpu

# GPU VRAM Ceiling (MB)
AICATCH_MAX_VRAM_MB=3000

# Logging Level (DEBUG, INFO, WARNING, ERROR)
LOG_LEVEL=INFO
